# Copy to .env (never commit .env). All values are optional.
MODELMATCH_HOST=127.0.0.1
MODELMATCH_PORT=8787
# The task analyst. Empty = built-in mock router (offline, keyword-based).
# Curvet AI gateway (recommended):     https://curvet.in/api/v1/chat/completions
#   with MODELMATCH_API_KEY = your Curvet App key and MODELMATCH_API_SECRET = your App secret
# Planned hosted contract:             https://workflow-copilot-ten.vercel.app/api/route
# Existing endpoint (adapter):         https://workflow-copilot-ten.vercel.app/api/analyze
# Local mock of the planned contract:  http://127.0.0.1:8787/mock/api/route
MODELMATCH_API_URL=
# route | analyze | curvet (empty = detected from the URL)
MODELMATCH_API_STYLE=
MODELMATCH_API_KEY=
MODELMATCH_API_SECRET=
# Seconds. Curvet default is 6 (answers usually take ~2 s); other routers default to 25.
MODELMATCH_API_TIMEOUT=
# Curvet model that analyses each prompt, and a backup started if it is slow (defaults shown).
MODELMATCH_ROUTER_MODEL=
MODELMATCH_ROUTER_FALLBACK_MODEL=
MODELMATCH_MAX_PROMPT_CHARS=8000
MODELMATCH_UPSTREAM_URL=https://api.anthropic.com
# auto | tty | dialog | auto-accept | never
MODELMATCH_CONFIRM_UI=auto
MODELMATCH_CONFIRM_TIMEOUT=30
MODELMATCH_LOG_PROMPTS=0
MODELMATCH_DISABLED=0

# ModelMatch V2: decision engine, learning from outcomes, cache-aware switch check.
# 0 = V1 behaviour (one recommendation per prompt, Use / Keep popup).
MODELMATCH_ROUTER_V2=0
MODELMATCH_PERSONALIZATION=1
MODELMATCH_CACHE_AWARE=1
# Switch without asking when the evidence is strong (off until you've built up history).
MODELMATCH_AUTO_ROUTE=0
# Comma-separated model ids or families ModelMatch must never / may only switch to.
MODELMATCH_DENIED_MODELS=
MODELMATCH_ALLOWED_MODELS=
